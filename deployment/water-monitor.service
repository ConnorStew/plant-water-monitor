[Unit]
Description= Plant Monitor Service
After=network.target

[Service]
ExecStart=/home/connor/.local/bin/uv run water-monitor
Restart=always
User=connor
WorkingDirectory=/home/connor/water-monitor
# Required to allow systemd to play audio.
Environment="PULSE_RUNTIME_PATH=/run/user/1000/pulse/"
# Skip dev dependencies on the Pi.
Environment="UV_NO_DEV=1"

[Install]
WantedBy=multi-user.target